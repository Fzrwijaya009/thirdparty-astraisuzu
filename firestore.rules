rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMaster() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'master' &&
        getUserData().status == 'approved'
      );
    }

    function isOwner() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'owner' &&
        getUserData().status == 'approved'
      );
    }

    function isAdminUser() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin' &&
        getUserData().status == 'approved'
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isMaster() || isOwner());
      // Self registration with pending status
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      // Master System can update any user (e.g. approve account), user can update their own profile name
      allow update: if isSignedIn() && (
        (isMaster()) ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
      );
      allow delete: if isMaster();
    }

    // SHIPMENTS (Surat Jalan Items)
    match /shipments/{itemId} {
      allow read: if isSignedIn();
      // Master System and Owner can upload any data
      allow create: if isSignedIn() && (isMaster() || isOwner());
      // Master and Owner can update/delete any data
      // Admin can only edit/delete items that have NOT been approved/completed by Owner
      allow update: if isSignedIn() && (
        isMaster() ||
        isOwner() ||
        (isAdminUser() && resource.data.status != 'completed')
      );
      allow delete: if isSignedIn() && (
        isMaster() ||
        isOwner() ||
        (isAdminUser() && resource.data.status != 'completed')
      );
    }

    // RETURN SALES (Shortage & Claims)
    match /return_sales/{claimId} {
      allow read: if isSignedIn();
      // Created automatically when discrepancy occurs
      allow create: if isSignedIn();
      // Admin, Owner, Master can submit documents (Opened -> Inprogress)
      // Only Owner and Master can perform Approval Claim (Inprogress -> Completed)
      allow update: if isSignedIn() && (
        isMaster() ||
        isOwner() ||
        (isAdminUser() && resource.data.status == 'opened' && request.resource.data.status == 'inprogress')
      );
      allow delete: if isMaster() || isOwner();
    }
  }
}
