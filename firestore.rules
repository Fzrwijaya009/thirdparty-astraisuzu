rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // USERS COLLECTION (TP-SYNCS Multi-device Authentication & Role Approvals)
    match /users/{userId} {
      allow read, write: if true;
    }

    // SHIPMENTS COLLECTION (Surat Jalan Items & Real-time Physical Checks)
    match /shipments/{itemId} {
      allow read, write: if true;
    }

    // RETURN SALES COLLECTION (Claims, Evidences & Approvals)
    match /return_sales/{claimId} {
      allow read, write: if true;
    }
  }
}
